# PostgreSQL Database Connection URL (e.g., Neon.tech, Supabase, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/veggieflick"

# Secret for signing JWT authentication cookies
SESSION_SECRET="super-secret-key-change-this-in-production-veggieflick"

# Canonical site URL (Update with your live Vercel URL, e.g. https://veggieflick.vercel.app)
NEXT_PUBLIC_SITE_URL="https://veggieflick.vercel.app"

# Optional Integrations (App degrades gracefully if left blank)
# Razorpay Payment Gateway
RAZORPAY_KEY_ID=""
RAZORPAY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# SMS Gateway (MSG91)
MSG91_API_KEY=""
MSG91_TEMPLATE_ID=""

# Email Notifications (Resend)
RESEND_API_KEY=""

# Google Maps API Key for location / distance calculation
GOOGLE_MAPS_API_KEY=""

# Admin 2FA Code
ADMIN_TOTP_CODE=""
